{
    "kind": "collectionType",
    "collectionName": "articles",
    "info": {
        "singularName": "article",
        "pluralName": "articles",
        "displayName": "Article",
        "description": "Technical blog posts"
    },
    "options": {
        "draftAndPublish": true
    },
    "pluginOptions": {},
    "attributes": {
        "title": {
            "type": "string",
            "required": true
        },
        "slug": {
            "type": "uid",
            "targetField": "title",
            "required": true
        },
        "summary": {
            "type": "text",
            "required": true
        },
        "content": {
            "type": "richtext",
            "required": true
        },
        "tags": {
            "type": "json"
        },
        "publishedAt": {
            "type": "datetime"
        }
    }
}